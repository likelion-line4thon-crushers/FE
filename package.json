{
  "name": "4thon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:ct": "playwright test -c playwright-ct.config.ts",
    "test:e2e": "playwright test",
    "test:install-browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "k6": "docker compose -f docker-compose.k6.yml run --rm k6",
    "k6:smoke": "docker compose -f docker-compose.k6.yml run --rm -e K6_PROFILE=smoke k6",
    "k6:target": "docker compose -f docker-compose.k6.yml run --rm -e K6_PROFILE=target k6",
    "k6:target-interaction": "docker compose -f docker-compose.k6.yml run --rm -e K6_PROFILE=target-interaction k6",
    "k6:headroom": "docker compose -f docker-compose.k6.yml run --rm -e K6_PROFILE=headroom k6",
    "k6:upload": "docker compose -f docker-compose.k6.yml run --rm -e K6_PROFILE=upload-smoke k6-upload",
    "k6:upload-all": "docker compose -f docker-compose.k6.yml run --rm -e K6_PROFILE=upload-smoke -e K6_UPLOAD_FILES=\"$(ls tests/k6/fixtures/*.pdf tests/k6/fixtures/*.pptx 2>/dev/null | sed 's|.*/|/fixtures/|' | paste -sd, -)\" k6-upload",
    "k6:upload-burst": "docker compose -f docker-compose.k6.yml run --rm -e K6_PROFILE=upload-burst k6-upload"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.2.1",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.12.2",
    "jotai": "^2.19.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.2",
    "sockjs-client": "^1.6.1",
    "styled-components": "^6.1.19",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@playwright/experimental-ct-react": "^1.58.2",
    "@playwright/test": "^1.58.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sockjs-client": "^1.5.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.55.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^13.19.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^5.0.8",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
