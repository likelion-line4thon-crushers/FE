# 백엔드 API 주소 (예: https://api.boini.shop/)
VITE_API_BASE_URL=

# FastAPI(AI 서버) 주소 (예: http://localhost:8000). 로컬 개발 시 필수로 설정해야
# AI 리포트/질문 클러스터링 요청이 Spring 백엔드가 아닌 FastAPI로 정상 전달됨.
VITE_AI_API_BASE_URL=

# PostHog 제품 분석 (프로젝트 설정 → Project API Key / Host, 예: https://us.i.posthog.com)
# 비워두면 이벤트가 전송되지 않을 뿐 앱 동작에는 영향 없음.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=